{
  "appId": "com.akilihub.sms",
  "productName": "AkiliHub SMS",
  "directories": {
    "buildResources": "public",
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.ts"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ],
    "certificateFile": null,
    "certificatePassword": null,
    "signingHashAlgorithms": [
      "sha256"
    ],
    "sign": null,
    "icon": "public/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AkiliHub SMS",
    "installerIcon": "public/logo.png",
    "uninstallerIcon": "public/logo.png",
    "installerHeaderIcon": "public/logo.png"
  },
  "portable": {
    "artifactName": "AkiliHub-SMS-${version}.exe"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.business",
    "icon": "public/logo.png"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Office",
    "icon": "public/logo.png"
  },
  "publish": {
    "provider": "github",
    "owner": "akilihub",
    "repo": "akilihub-sms"
  }
}
